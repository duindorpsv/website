APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
# Supabase SQL: use a restricted runtime account and a separate migration account.
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_DATABASE_PASSWORD=
# Cloud database CA certificate, Base64 on one line. Required in production.
DATABASE_CA_CERT_B64=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
MEDIA_DRIVER=s3
# Private Supabase Storage bucket and generated server-side S3 credentials.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Resend HTTPS API for website, account activation and recovery mail.
RESEND_API_KEY=
MAIL_FROM=
# Required for development/test mail; leave empty in production.
TEST_MAIL_TO=
SPORTLINK_CLIENT_ID=
RELEASE_DIGEST=
TRUST_PROXY_IP=false
NEWS_IMPORT_MAX_MB=512
NEWS_IMPORT_MAX_UNPACKED_MB=2048
NEWS_IMPORT_MAX_ENTRIES=10000
