APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://APP_USER:CHANGE_ME@database:5432/duindorp
MIGRATION_DATABASE_URL=postgres://MIGRATION_USER:CHANGE_ME@database:5432/duindorp
# Generate at least 32 random bytes; set outside Git.
AUTH_SESSION_SECRET=
MEDIA_DRIVER=filesystem
MEDIA_ROOT=/data/media
# Staging/production require S3 and their own bucket/credentials.
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TEST_MAIL_TO=
SPORTLINK_CLIENT_ID=
NEWSLETTER_PROVIDER=disabled
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
RELEASE_DIGEST=

# Only true when the reverse proxy overwrites X-Real-IP and direct access is blocked.
TRUST_PROXY_IP=false

# Operator-only database provisioning; keep outside the web runtime file.
APP_DATABASE_PASSWORD=
# Development Compose only:
DEV_DB_PASSWORD=

# News archive upload / expansion / entry limits (MiB, MiB, count). GitHub Environment variables.
NEWS_IMPORT_MAX_MB=512
NEWS_IMPORT_MAX_UNPACKED_MB=2048
NEWS_IMPORT_MAX_ENTRIES=10000
